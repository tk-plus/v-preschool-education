.page {
  padding: 48rpx 36rpx;
}
.hero {
  display: flex;
  flex-direction: column;
  padding: 60rpx 30rpx 54rpx;
  background: linear-gradient(145deg, #dff4d1, #f0f9e8);
  border-radius: 32rpx;
}
.eyebrow {
  color: #59885c;
  font-size: 26rpx;
}
.title {
  margin-top: 16rpx;
  font-size: 68rpx;
  font-weight: 800;
  color: #245437;
}
.subtitle {
  margin-top: 18rpx;
  font-size: 29rpx;
  color: #46644e;
}
.module {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(50, 90, 60, 0.08);
}
.module-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: #ffdf9d;
  color: #83581a;
  font-size: 50rpx;
  font-weight: bold;
}
.module-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 24rpx;
}
.module-title {
  font-size: 36rpx;
  font-weight: 700;
}
.module-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #77837a;
}
.arrow {
  color: #9fa9a1;
  font-size: 52rpx;
}
.note {
  margin-top: 32rpx;
  text-align: center;
  color: #93a195;
  font-size: 24rpx;
}
